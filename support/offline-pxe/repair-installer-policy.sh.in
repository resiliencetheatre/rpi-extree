#!/bin/sh
# Generated by make-installer-policy-fix.py; run on the Pi with no clients installing.
set -eu
[ "$#" -eq 1 ] && [ "$1" = --no-active-installers ] || {
    echo 'Usage: sh repair-installer-policy.sh --no-active-installers' >&2; exit 2;
}
[ "$(id -u)" = 0 ]
. /etc/offline-pxe/runtime.conf
[ "$(findmnt -rn -M /srv/offline -o UUID)" = "$SSD_UUID" ]
[ "$(findmnt -rn -M /srv/offline -o FSTYPE)" = ext4 ]
generation=$(readlink -f /srv/offline/current)
case "$generation" in /srv/offline/generations/*) ;; *) exit 1;; esac
mkdir -p /run/offline-pxe
exec 9>/run/offline-pxe/activation.lock
flock -n 9
cd "$generation"
sha256sum -c ready.sha256 >/dev/null
if [ -f installer-policy-fix.txt ]; then
    echo 'Installer policy fix already applied and checksums passed.'
    exit 0
fi
grep -q '"apt-mirror-setup": "\(1:\)\?0.198"' manifest.json
grep -q 'preseed/early_command' www/preseed/offline.cfg
grep -q 'preseed/early_command' www/preseed/interactive.cfg
[ -f www/preseed/early.sh ] && [ ! -L www/preseed/early.sh ]
if grep -q '^# In apt-setup 0.198,' www/preseed/early.sh; then
    echo 'Generation already contains the policy hook.'; exit 0
fi
# A failure keeps maintenance set and services stopped. Package data is untouched.
failed_cleanup() {
    mount -o remount,ro /srv/offline || :
    echo 'Repair incomplete; services remain stopped. Preserve the backup for diagnosis.' >&2
}
trap failed_cleanup EXIT
: > /run/offline-pxe/maintenance
systemctl stop offline-recover.timer offline-recover.service
systemctl stop offline-dnsmasq.service offline-nginx.service
mount -o remount,rw /srv/offline
backup=installer-policy-backup
[ ! -e "$backup" ]
mkdir "$backup"
cp -p ready.sha256 "$backup/ready.sha256"
cp -p www/preseed/early.sh "$backup/early.sh"
cp -p www/preseed/early.sh www/preseed/early.sh.new
cat >> www/preseed/early.sh.new <<'OFFLINE_POLICY_FIX_PAYLOAD'

@POLICY_HOOK@
OFFLINE_POLICY_FIX_PAYLOAD
sh -n www/preseed/early.sh.new
mv www/preseed/early.sh.new www/preseed/early.sh
{
    echo 'Installer policy v1: suppress apt-setup 0.198 50mirror; use 60local.'
    echo 'Package pool, indexes, signed Releases and original manifest are unchanged.'
    date -u
    sha256sum "$backup/early.sh" "$backup/ready.sha256" www/preseed/early.sh
} > installer-policy-fix.txt
awk '$2 != "www/preseed/early.sh" { print }' "$backup/ready.sha256" > ready.sha256.new
sha256sum www/preseed/early.sh installer-policy-fix.txt >> ready.sha256.new
mv ready.sha256.new ready.sha256
sha256sum -c ready.sha256 >/dev/null
sync
mount -o remount,ro /srv/offline
rm /run/offline-pxe/maintenance
/usr/sbin/offline-ready
systemctl start offline-dnsmasq.service offline-nginx.service
systemctl start offline-recover.timer
trap - EXIT
echo 'Installer policy repaired. Restart laptop PXE installation from the beginning.'

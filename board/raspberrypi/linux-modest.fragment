# Modest peripheral reduction for raspberrypi5_videoterm.
# Apply after bcm2712_defconfig and before videoterm.fragment.
# Keep CPU/platform defaults, filesystems, networking, camera sensors and SoC codecs.
# Recheck exclusions and required hardware after kernel updates.

CONFIG_MACSEC=m
CONFIG_BRCMFMAC_SDIO=y


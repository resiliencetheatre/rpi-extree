# Build the Pi 4 DSI display path in for a framebuffer console at boot.
CONFIG_DRM=y
CONFIG_DRM_VC4=y
CONFIG_DRM_PANEL_WAVESHARE_TOUCHSCREEN=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_I2C=y
CONFIG_I2C_BCM2835=y
CONFIG_TOUCHSCREEN_GOODIX=y
CONFIG_INPUT_EVDEV=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y

# CCID uses libusb through USB device nodes; USB audio supports UDPPTT.
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_XHCI_PCI=y
CONFIG_SND_USB_AUDIO=m

# Camera Module v1.3: sensor, CSI capture and VC4 ISP for libcamera.
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_DEV=m
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_VIDEO_OV5647=m
CONFIG_VIDEO_BCM2835_UNICAM=m
CONFIG_BCM2835_VCHIQ=y
CONFIG_VIDEO_ISP_BCM2835=m

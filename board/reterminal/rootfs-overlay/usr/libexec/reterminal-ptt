#!/usr/bin/python3
"""Bridge reTerminal KEY_F events to the udpptt control socket."""
import glob
import os
import select
import signal
import struct
import subprocess
import sys
import time

EVENT = struct.Struct('@llHHi')  # Linux input_event, native timeval ABI
EV_KEY, EV_SYN, SYN_DROPPED, SYN_REPORT = 1, 0, 3, 0
KEY_F = 33
running = True


def stop(_signum, _frame):
    global running
    running = False


def find_device():
    override = os.environ.get('RETERMINAL_PTT_DEVICE')
    if override:
        return override
    for path in sorted(glob.glob('/sys/class/input/event*/device/name')):
        try:
            with open(path) as name:
                if name.read().strip() == 'gpio_keys':
                    return '/dev/input/' + path.split('/')[-3]
        except OSError:
            continue
    return None


def send_ptt(pressed):
    try:
        result = subprocess.run(
            ['ptt_helper', '--socket', os.environ.get('RETERMINAL_PTT_SOCKET', '/tmp/udpptt.sock'),
             '--ptt_down' if pressed else '--ptt_up'],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=1)
        return result.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def socket_identity():
    try:
        stat = os.stat(os.environ.get('RETERMINAL_PTT_SOCKET', '/tmp/udpptt.sock'))
        return stat.st_dev, stat.st_ino, stat.st_ctime_ns
    except OSError:
        return None


def main():
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    fd = None
    pending = b''
    pressed = False
    delivered = None
    endpoint = None
    dropped = False
    try:
        while running:
            current_endpoint = socket_identity()
            # Resend after client restart (the socket inode changes), or retry
            # a failed command. Only this helper should own socket-based PTT.
            if delivered != pressed or current_endpoint != endpoint:
                if send_ptt(pressed):
                    delivered, endpoint = pressed, current_endpoint
                else:
                    delivered = None

            if fd is None:
                path = find_device()
                try:
                    if not path:
                        raise FileNotFoundError('gpio_keys not found')
                    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
                    print('PTT input: ' + path + ' KEY_F', flush=True)
                    pending = b''
                    dropped = False
                except OSError:
                    time.sleep(0.5)
                    continue

            if not select.select([fd], [], [], 0.2)[0]:
                continue
            try:
                data = os.read(fd, EVENT.size * 32)
                if not data:
                    raise OSError('input disconnected')
            except OSError:
                os.close(fd)
                fd = None
                pressed = False
                send_ptt(False)
                delivered = None
                continue
            pending += data
            while running and len(pending) >= EVENT.size:
                _, _, kind, code, value = EVENT.unpack(pending[:EVENT.size])
                pending = pending[EVENT.size:]
                if kind == EV_SYN and code == SYN_DROPPED:
                    # Do not risk holding TX after losing a release event.
                    pressed = False
                    dropped = True
                elif dropped:
                    if kind == EV_SYN and code == SYN_REPORT:
                        dropped = False
                    # Remain released until a fresh KEY_F press.
                elif kind == EV_KEY and code == KEY_F and value in (0, 1):
                    pressed = value == 1
                else:
                    continue
                # Send each edge immediately, including short press/release
                # pairs returned in one read. Ignore value=2 autorepeats.
                if delivered != pressed:
                    if send_ptt(pressed):
                        delivered, endpoint = pressed, socket_identity()
                    else:
                        delivered = None
    finally:
        if fd is not None:
            os.close(fd)
        send_ptt(False)


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print('reterminal-ptt: ' + str(error), file=sys.stderr)
        sys.exit(1)

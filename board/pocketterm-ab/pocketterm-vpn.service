[Unit]
Description=Load device-owned persistent wstunnel unit
Requires=pocketterm-ab-prepare.service
After=pocketterm-ab-prepare.service
ConditionPathExists=/etc/default/pocketterm-vpn/wstunnel.service

[Service]
Type=oneshot
# PID 1 initially scans units before Data and /etc/default are mounted.
ExecStart=/bin/systemctl daemon-reload
ExecStart=/bin/systemctl --no-block start wstunnel.service
ExecStart=/bin/systemctl --no-block start spacecomd.service
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

config BR2_PACKAGE_PYTHON_MESHTASTIC
	bool "python-meshtastic"
	select BR2_PACKAGE_PYTHON_SERIAL
	select BR2_PACKAGE_PYTHON_PROTOBUF
	select BR2_PACKAGE_PYTHON_REQUESTS
	select BR2_PACKAGE_PYTHON_PYYAML
	select BR2_PACKAGE_PYTHON_PYPUBSUB
	select BR2_PACKAGE_PYTHON_BLEAK
	select BR2_PACKAGE_PYTHON_PACKAGING
	select BR2_PACKAGE_PYTHON_TABULATE
	help
	  Python client for Meshtastic devices.

	  https://github.com/meshtastic/python

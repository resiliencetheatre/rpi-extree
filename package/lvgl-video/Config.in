config BR2_PACKAGE_LVGL_VIDEO
	bool "lvgl-video"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS_NPTL
	depends on BR2_USE_MMU
	depends on BR2_USE_WCHAR
	depends on BR2_PACKAGE_WEBRTC_AUDIO_PROCESSING_ARCH_SUPPORTS
	depends on BR2_PACKAGE_LIBABSEIL_CPP_ARCH_SUPPORTS
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_10
	depends on !BR2_STATIC_LIBS
	depends on BR2_PACKAGE_LIBCAMERA
	select BR2_PACKAGE_GSTREAMER1
	select BR2_PACKAGE_GSTREAMER1_PARSE
	select BR2_PACKAGE_GST1_PLUGINS_BASE
	select BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_APP
	select BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_AUDIOCONVERT
	select BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_AUDIORESAMPLE
	select BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_ALSA
	select BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_OPUS
	select BR2_PACKAGE_GST1_PLUGINS_BAD
	select BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_WEBRTCDSP
	select BR2_PACKAGE_GST1_PLUGINS_GOOD
	select BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_RTP
	select BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_RTPMANAGER
	select BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_UDP
	select BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_V4L2
	select BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_VPX
	select BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VIDEOCONVERTSCALE
	help
	  Local camera preview and GTK Pipe-compatible VP8/Opus RTP
	  conferencing at fixed 640x480, 10 fps.
	  Uses ALSA audio with optional WebRTC echo cancellation.
	  Supports framebuffer and Wayland presentation.

if BR2_PACKAGE_LVGL_VIDEO

config BR2_PACKAGE_LVGL_VIDEO_WAYLAND
	bool "Wayland backend"
	depends on !BR2_STATIC_LIBS
	select BR2_PACKAGE_WAYLAND
	select BR2_PACKAGE_WAYLAND_PROTOCOLS
	select BR2_PACKAGE_LIBXKBCOMMON
	help
	  Render the UI into Wayland shared-memory buffers. Weston owns
	  the display and input devices. Without this option, use fbdev.

endif

comment "lvgl-video needs libcamera and a toolchain w/ C++, NPTL, wchar"
	depends on BR2_USE_MMU
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS_NPTL || \
		!BR2_USE_WCHAR || !BR2_PACKAGE_LIBCAMERA

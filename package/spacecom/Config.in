config BR2_PACKAGE_SPACECOM
	bool "spacecom"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_NORM
	help
	  spacecom-send and spacecom-recv utilities built on top of NORM.

comment "spacecom needs a toolchain w/ C++, threads"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS

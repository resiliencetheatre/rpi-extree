config BR2_PACKAGE_PYTHON_DATEUTILS
	bool "python-dateutils"
	# argparse is provided by Python 3; the old backport shadows its stdlib.
	select BR2_PACKAGE_PYTHON_DATEUTIL # runtime
	select BR2_PACKAGE_PYTHON_PYTZ # runtime
	help
	  Various utilities for working with date and datetime
	  objects.

	  https://github.com/jmcantrell/python-dateutils

config BR2_PACKAGE_PYTHON_TAKY_NG
	bool "python-taky-ng"
	depends on BR2_PACKAGE_PYTHON3
	select BR2_PACKAGE_PYTHON_LXML
	select BR2_PACKAGE_PYTHON_CRYPTOGRAPHY
	select BR2_PACKAGE_PYTHON_DATEUTIL
	select BR2_PACKAGE_PYTHON_FLASK
	select BR2_PACKAGE_PYTHON_GUNICORN
	select BR2_PACKAGE_PYTHON_REDIS
	help
	  A simple TAK server and COT router.

	  https://codeberg.org/hunterSG7/taky-ng

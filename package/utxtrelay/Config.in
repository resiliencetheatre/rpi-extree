config BR2_PACKAGE_UTXTRELAY
	bool "utxtrelay"
	depends on BR2_USE_MMU
	select BR2_PACKAGE_LIBSODIUM
	help
	  UDP text relay server, terminal client, and Unix-domain socket
	  connector for lvgl-console. Fetches a pinned Git revision
	  from upstream and builds without ncurses.

	  https://github.com/resiliencetheatre/utxtrelay

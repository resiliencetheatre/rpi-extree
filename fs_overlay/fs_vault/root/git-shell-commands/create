#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
    echo "Usage: create <project.git>" >&2
    exit 1
fi

project=$1
case "$project" in
    ''|.*|-*|*[!a-zA-Z0-9._-]*)
        echo "Invalid project name: use letters, digits, dots, underscores or hyphens; start with a letter or digit." >&2
        exit 1
        ;;
esac
case "$project" in
    *.git) ;;
    *) project="$project.git" ;;
esac

cd "$HOME"
mkdir "$project"
git init --bare --shared "./$project"
echo "$project repository created. Check with 'list'"

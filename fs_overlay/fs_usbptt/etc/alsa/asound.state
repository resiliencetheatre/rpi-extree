state.Audio {
	control.1 {
		iface PCM
		name 'Capture Channel Map'
		value.0 0
		value.1 0
		comment {
			access 'read volatile'
			type INTEGER
			count 2
			range '0 - 36'
		}
	}
	control.2 {
		iface PCM
		name 'Playback Channel Map'
		value.0 3
		value.1 4
		comment {
			access 'read volatile'
			type INTEGER
			count 2
			range '0 - 36'
		}
	}
	control.3 {
		iface MIXER
		name 'Headset Capture Switch'
		value true
		comment {
			access 'read write'
			type BOOLEAN
			count 1
		}
	}
	control.4 {
		iface MIXER
		name 'Headset Capture Volume'
		value 117
		comment {
			access 'read write'
			type INTEGER
			count 1
			range '0 - 120'
			dbmin -6000
			dbmax 0
			dbvalue.0 -150
		}
	}
	control.5 {
		iface CARD
		name 'Clock Source 1 Validity'
		value true
		comment {
			access read
			type BOOLEAN
			count 1
		}
	}
	control.6 {
		iface MIXER
		name 'Headset Playback Switch'
		value true
		comment {
			access 'read write'
			type BOOLEAN
			count 1
		}
	}
	control.7 {
		iface MIXER
		name 'Headset Playback Volume'
		value 117
		comment {
			access 'read write'
			type INTEGER
			count 1
			range '0 - 120'
			dbmin -6000
			dbmax 0
			dbvalue.0 -150
		}
	}
	control.8 {
		iface CARD
		name 'Clock Source 2 Validity'
		value true
		comment {
			access read
			type BOOLEAN
			count 1
		}
	}
}

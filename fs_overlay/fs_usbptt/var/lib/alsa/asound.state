state.UACDemoV10 {
	control.1 {
		iface PCM
		name 'Playback Channel Map'
		value 7
		comment {
			access 'read volatile'
			type INTEGER
			count 1
			range '0 - 36'
		}
	}
	control.2 {
		iface PCM
		name 'Capture Channel Map'
		value 0
		comment {
			access 'read volatile'
			type INTEGER
			count 1
			range '0 - 36'
		}
	}
	control.3 {
		iface MIXER
		name 'PCM Playback Switch'
		value true
		comment {
			access 'read write'
			type BOOLEAN
			count 1
		}
	}
	control.4 {
		iface MIXER
		name 'PCM Playback Volume'
		value 120
		comment {
			access 'read write'
			type INTEGER
			count 1
			range '0 - 147'
			dbmin -2837
			dbmax -94
			dbvalue.0 -598
		}
	}
	control.5 {
		iface MIXER
		name 'Mic Capture Switch'
		value true
		comment {
			access 'read write'
			type BOOLEAN
			count 1
		}
	}
	control.6 {
		iface MIXER
		name 'Mic Capture Volume'
		value 140
		comment {
			access 'read write'
			type INTEGER
			count 1
			range '0 - 147'
			dbmin -2837
			dbmax -94
			dbvalue.0 -225
		}
	}
	control.7 {
		iface MIXER
		name 'Auto Gain Control'
		value false
		comment {
			access 'read write'
			type BOOLEAN
			count 1
		}
	}
}

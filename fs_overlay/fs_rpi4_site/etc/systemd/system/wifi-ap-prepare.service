[Unit]
Description=Prepare concurrent Wi-Fi access point
After=iwd.service systemd-networkd.service wifi-ap-interface.service
Requires=iwd.service wifi-ap-interface.service
Before=hostapd.service

[Service]
Type=oneshot
ExecStart=/usr/bin/prepare-wifi-ap
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

[Unit]
Description=Situation TAK position bridge
After=network-online.target situation-map.service taky-ng.service
Wants=network-online.target
Requires=situation-map.service taky-ng.service

[Service]
Type=simple
WorkingDirectory=/opt/situation
ExecStart=/usr/bin/python3 /opt/situation/tak-bridge.py \
    --host 127.0.0.1 \
    --port 8087 \
    --url http://127.0.0.1:8080/api/positions
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

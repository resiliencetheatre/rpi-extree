#!/bin/sh
#
# codec2 is OTP (requires udpproxy in/out)
# opus is OTP (unused)
#
# udpptt is symmetric (word of day) (does not require udpproxy)
# - audioreceiver-udpptt.service:
#   - /bin/ptt-client-from-ini.sh
# - audiostreamer-udpptt.service
#   - ptt_helper --socket /tmp/udpptt.sock --ptt_[down/up]
#
# spacecom is cleartext and requires no udpproxy
#

set -eu

SYSTEMD_DIR="/etc/systemd/system"
MODE_STATE="/run/audio-mode-selected"
LOG_TAG="set-audio-mode"

log() {
    logger -t "$LOG_TAG" -- "$*"
    echo "$LOG_TAG: $*"
}

usage() {
    echo "Usage: $0 {codec2|opus|udpptt|spacecom}" >&2
    exit 1
}

[ $# -eq 1 ] || usage

MODE="$1"

case "$MODE" in
    codec2|opus|udpptt|spacecom)
        ;;
    *)
        log "invalid mode: $MODE"
        echo "Error: invalid mode: $MODE" >&2
        usage
        ;;
esac

RX_TARGET="$SYSTEMD_DIR/audioreceiver-$MODE.service"
TX_TARGET="$SYSTEMD_DIR/audiostreamer-$MODE.service"

RX_LINK="$SYSTEMD_DIR/audioreceiver.service"
TX_LINK="$SYSTEMD_DIR/audiostreamer.service"

if [ ! -f "$RX_TARGET" ]; then
    log "missing receiver service: $RX_TARGET"
    echo "Error: missing receiver service: $RX_TARGET" >&2
    exit 1
fi

if [ ! -f "$TX_TARGET" ]; then
    log "missing streamer service: $TX_TARGET"
    echo "Error: missing streamer service: $TX_TARGET" >&2
    exit 1
fi

mkdir -p /run
printf '%s\n' "$MODE" > "$MODE_STATE"
log "saved selected mode: $MODE"

log "stopping generic audio services before relinking"
systemctl stop audioreceiver.service || true
systemctl stop audiostreamer.service || true

rm -f "$RX_LINK" "$TX_LINK"

ln -s "$RX_TARGET" "$RX_LINK"
ln -s "$TX_TARGET" "$TX_LINK"
log "updated links: $RX_LINK -> $RX_TARGET, $TX_LINK -> $TX_TARGET"

systemctl daemon-reload
log "systemd daemon reloaded"

case "$MODE" in
    codec2|opus)
        log "starting udpproxy services for mode $MODE"
        systemctl start udpproxy-in.service
        systemctl start udpproxy-out.service

        log "stopping spacecom stack"
        systemctl stop spacecom-stack.target || true

        log "restarting audioreceiver.service"
        systemctl restart audioreceiver.service || true
        ;;
    udpptt)
        log "stopping udpproxy services for mode udpptt"
        systemctl stop udpproxy-in.service || true
        systemctl stop udpproxy-out.service || true

        log "stopping spacecom stack"
        systemctl stop spacecom-stack.target || true

        log "restarting audioreceiver.service"
        systemctl restart audioreceiver.service || true
        ;;
    spacecom)
        log "stopping udpproxy services for mode spacecom"
        systemctl stop udpproxy-in.service || true
        systemctl stop udpproxy-out.service || true

        if ! mountpoint -q /mnt/internaldrive; then
            log "spacecom selected, but /mnt/internaldrive is not mounted yet"
            exit 0
        fi

        if ! ip link show wg0 >/dev/null 2>&1; then
            log "spacecom selected, but wg0 is not up yet"
            exit 0
        fi

        log "restarting spacecom-stack.target"
        systemctl restart spacecom-stack.target || true
        ;;
esac

log "audio mode set to: $MODE"
log "$RX_LINK -> $RX_TARGET"
log "$TX_LINK -> $TX_TARGET"

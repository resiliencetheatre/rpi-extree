#!/bin/sh
set -eu

if [ -z "${UDPPTT_SERVER:-}" ]; then
    echo "Set UDPPTT_SERVER in /etc/default/udpptt before starting the service." >&2
    exit 1
fi

umask 077
# ExecStart reads this environment file again after ExecStartPre completes.
# Old configurations without the toggle retain the enabled preamble.
mkdir -p /run/udpptt
case "${UDPPTT_PREAMBLE_ENABLED:-1}" in
    0) printf 'UDPPTT_PREAMBLE_ARGS=\n' > /run/udpptt/preamble.env ;;
    1)
        case "${UDPPTT_PREAMBLE_ID:-POCKT}" in
            [A-Z][A-Z][A-Z][A-Z][A-Z]) ;;
            *) echo "Preamble ID must contain five uppercase letters" >&2; exit 1 ;;
        esac
        printf 'UDPPTT_PREAMBLE_ARGS=--preamble-id %s\n' "${UDPPTT_PREAMBLE_ID:-POCKT}" > /run/udpptt/preamble.env
        ;;
    *) echo "UDPPTT_PREAMBLE_ENABLED must be 0 or 1" >&2; exit 1 ;;
esac
key_dir=/root/.config/udpptt
mkdir -p "$key_dir"
secret=$key_dir/dpi.secret
public=$key_dir/dpi.public

if [ -f "$secret" ] && [ -f "$public" ]; then
    exit 0
fi

# Never replace an existing identity or generate a mismatched public key.
if [ -e "$secret" ] || [ -L "$secret" ] || [ -e "$public" ] || [ -L "$public" ]; then
    echo "Incomplete DPI key pair in $key_dir; restore the matching pair before starting udpptt." >&2
    exit 1
fi

exec /usr/bin/ptt_dpi_keygen --secret "$secret" --public "$public"

#!/bin/sh
set -eu

monitor=${1:-}
case "$monitor" in
    gateway)
        # Prefer the lowest-metric IPv4 default route with a next-hop gateway.
        destination=$(ip -4 route show default | awk '
            $1 == "default" {
                gateway = ""; metric = 0
                for (i = 2; i <= NF; i++) {
                    if ($i == "via") gateway = $(i + 1)
                    if ($i == "metric") metric = $(i + 1)
                }
                if (gateway != "" && (!found || metric < best)) {
                    found = 1; best = metric; selected = gateway
                }
            }
            END { print selected }')
        ;;
    internet) destination=1.1.1.1 ;;
    vps) destination=${UDPPTT_SERVER:-} ;;
    wireguard) destination=${DPINGER_WIREGUARD_ENDPOINT:-} ;;
    *) echo "Unknown dpinger monitor: $monitor" >&2; exit 1 ;;
esac

if [ -z "$destination" ]; then
    echo "No destination configured/available for $monitor" >&2
    exit 1
fi

mkdir -p /tmp/dpinger
status=/tmp/dpinger/$monitor.status
rm -f "$status" "$status.new"
echo "Monitoring $monitor: $destination" >&2

# Keep stdout as plain three-number reports (no -i). Publish complete snapshots
# with rename so readers never see a truncated or partially written report.
# systemd stops the entire pipeline and removes reports through ExecStopPost.
/usr/bin/dpinger -f -s 1s -l 3s -t 10s -r 1s "$destination" |
while IFS= read -r report; do
    printf '%s\n' "$report" > "$status.new"
    mv -f "$status.new" "$status"
done
# EOF means dpinger stopped, even if the shell pipeline returned success.
exit 1

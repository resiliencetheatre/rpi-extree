[Unit]
Description=UTXT relay connector for LVGL messaging
Wants=network-online.target
After=network-online.target
Before=lvgl-console.service

[Service]
Type=notify
NotifyAccess=main
EnvironmentFile=/etc/default/utxtrelay
RuntimeDirectory=utxtrelay
RuntimeDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/utxtrelay-console-client -s ${UTXTRELAY_SERVER} -p ${UTXTRELAY_PORT} -n ${UTXTRELAY_NAME} -r ${UTXTRELAY_ROOM} --socket /run/utxtrelay/console.sock
Restart=on-failure
RestartSec=5s
TimeoutStartSec=15s
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

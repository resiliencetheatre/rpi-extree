[Unit]
Description=lvgl application
After=multi-user.target dpinger.service
Conflicts=psplash.service

[Service]
WorkingDirectory=/opt/lvgl-com
Type=simple
ExecStartPre=/bin/sh -c 'for i in $(seq 1 40); do [ -e /dev/input/touchscreen ] && exit 0; sleep 0.1; done; echo "touchscreen symlink missing" >&2; exit 1'
ExecStart=/bin/lvgl-com
Restart=always
RestartSec=5


[Install]
WantedBy=multi-user.target
